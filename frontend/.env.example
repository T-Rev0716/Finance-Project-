# Next.js server configuration. Placeholders only — never commit real values.
# Locally: copy to frontend/.env.local. Deployed: set in the host's dashboard.
# None of these may use a NEXT_PUBLIC_ prefix: they are read on the server only.

# production (default when unset) | development | test
ADVISORLENS_ENV=development

# The API's origin (no path). Must be https in production.
ADVISORLENS_BACKEND_URL=http://127.0.0.1:8000

# Must equal the API's ADVISORLENS_BACKEND_SECRET.
ADVISORLENS_BACKEND_SECRET=REPLACE_ME_with_a_random_value_of_at_least_32_characters

# Seals session cookies; at least 32 characters and different from the backend secret.
# Rotating it signs everyone out. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADVISORLENS_SESSION_SECRET=REPLACE_ME_with_a_different_random_value_of_32_plus_characters

# The exact origin people use to open this site; state-changing requests from any other
# origin are refused. Must be https in production.
ADVISORLENS_PUBLIC_ORIGIN=http://localhost:3000

# Set to true only behind a proxy that overwrites X-Forwarded-For (e.g. Vercel).
ADVISORLENS_TRUST_PROXY_HEADERS=false

# Absolute session lifetime in hours (0.25–24). Default 8.
# ADVISORLENS_SESSION_TTL_HOURS=8
