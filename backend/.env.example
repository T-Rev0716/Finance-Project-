# Copy to .env for local overrides, or set these in your host's dashboard
# (e.g. Railway > Variables). None are required to run the deterministic
# generator — only ADVISORLENS_DB and ADVISORLENS_CORS_ORIGINS matter for a
# real deployment.

# Comma-separated list of extra allowed frontend origins, besides localhost:3000.
# Set this to your deployed frontend URL (e.g. https://your-app.vercel.app).
ADVISORLENS_CORS_ORIGINS=

# SQLite file path. Point this at a mounted persistent volume in production
# (e.g. /data/advisorlens.db on Railway) so saved analyses survive redeploys.
ADVISORLENS_DB=

# Optional: enables the llm-v1 brief generator. Leave unset to use the
# deterministic generator only (the default, and what ships without these).
ADVISORLENS_LLM_PROVIDER=openai-compatible
ADVISORLENS_LLM_MODEL=gpt-4o-mini
ADVISORLENS_LLM_BASE_URL=https://api.openai.com/v1
ADVISORLENS_LLM_API_KEY=
ADVISORLENS_LLM_TIMEOUT_SECONDS=30
