# API configuration. Placeholders only — never commit real values.
# Locally: copy to backend/.env and load with `set -a && . ./.env && set +a`.
# Deployed: set these in the host's dashboard (e.g. Railway > Variables).

# production (default when unset): refuses to start without valid security settings.
# development: starts, but denies protected requests until configured; API docs enabled.
# test: used by automated tests with explicit test credentials.
ADVISORLENS_ENV=development

# Shared with the Next.js server; at least 32 characters, different from the session secret.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADVISORLENS_BACKEND_SECRET=REPLACE_ME_with_a_random_value_of_at_least_32_characters
# Only during a backend-secret rotation (see DEPLOY.md):
# ADVISORLENS_BACKEND_SECRET_PREVIOUS=

# scrypt hash of the shared demo password. Generate: .venv/bin/python -m app.security hash-password
# Keep the single quotes: the hash contains `$` characters.
ADVISORLENS_DEMO_PASSWORD_HASH='REPLACE_ME_with_the_scrypt_hash'

# SQLite file. In production, point at a persistent volume (e.g. /data/advisorlens.db).
ADVISORLENS_DB=

# Optional: enables the llm-v1 brief generator. Leave unset for deterministic briefs only.
# ADVISORLENS_LLM_PROVIDER=openai-compatible
# ADVISORLENS_LLM_MODEL=gpt-4o-mini
# ADVISORLENS_LLM_BASE_URL=https://api.openai.com/v1
# ADVISORLENS_LLM_API_KEY=
# ADVISORLENS_LLM_TIMEOUT_SECONDS=30
